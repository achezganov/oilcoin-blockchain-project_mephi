# Generate: openssl rand -hex 32
# Required; replace before starting. Also encrypts wallet private keys.
# Back up this value securely; never rotate it without re-encrypting old keys.
SECRET_KEY=

# Host port is bound to 127.0.0.1; nginx on the VPS proxies to it.
APP_PORT=8080

# Initial chain difficulty. Existing chains retain their consensus settings.
MINING_DIFFICULTY=3

# Enable only on a private demonstration instance: demo passwords are public.
ENABLE_DEMO=false

# false for local http://localhost:8080; true after enabling HTTPS on the VPS.
COOKIE_SECURE=false

# true only behind your trusted nginx proxy; keep the application port private.
TRUST_PROXY=false

# Compose starts app + worker on the same volume/key. Both are required.
# Manual block mining is deliberately disabled in compose.yaml.
